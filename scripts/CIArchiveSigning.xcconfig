// Archive with the same distribution assets that ExportOptions.plist uses.
// The target xcconfigs consume these settings independently so each target gets
// its own provisioning profile.
// Release builds always carry upstream's identity and team, whatever a developer's
// Config/Shared/Local.xcconfig says: -xcconfig wins over every included file,
// and this file includes Identity.xcconfig but not Local.xcconfig.
#include "../Config/Shared/Identity.xcconfig"

SWP_CODE_SIGN_STYLE = Manual
SWP_CODE_SIGN_IDENTITY = Apple Distribution
SWP_APP_PROVISIONING_PROFILE = swift-paperless AppStore CI
SWP_SHARE_EXTENSION_PROVISIONING_PROFILE = swift-paperless ShareExtension AppStore CI
SWP_FILE_PROVIDER_EXTENSION_PROVISIONING_PROFILE = swift-paperless FileProviderExtension AppStore CI
