// Copy this file to Config/Shared/Local.xcconfig (ignored by git) to build and
// sign the app on your own device under your own Apple team. Base.xcconfig
// includes it last, so it overrides project-level settings only (those in
// Base.xcconfig and Identity.xcconfig); a key that a target xcconfig sets
// (Config/App, Config/*Extension) still wins. Set only the keys below: the team
// and the SWP_* identity keys (SWP_KEYCHAIN_GROUP is derived, and rarely needs
// a value of its own). Release archives ignore this file.
// See docs/development/local-build.md, "Building on your own device".

// Your team id (Xcode > Settings > Accounts, or developer.apple.com > Membership).
DEVELOPMENT_TEAM = ABCDE12345

// A bundle id prefix you own. The extensions get .ShareExtension and
// .FileProviderExtension appended to it.
SWP_BUNDLE_ID_PREFIX = com.example.swift-paperless

// An app group registered to your team; it must start with "group.".
SWP_APP_GROUP = group.com.example.swift-paperless
