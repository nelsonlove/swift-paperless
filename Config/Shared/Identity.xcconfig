// The app's identity: the bundle id prefix, the app group and the keychain
// group. Every target derives its ids from these, so a fork can build and sign
// under its own Apple team by overriding them in Local.xcconfig (see
// Local.xcconfig.example and docs/development/local-build.md) without changing
// any source file.
//
// The app and its extensions read SWP_BUNDLE_ID_PREFIX and SWP_APP_GROUP at run
// time from their Info.plist (SWPBundleIDPrefix, SWPAppGroupIdentifier); see
// Common/Sources/Common/AppIdentity.swift.

SWP_BUNDLE_ID_PREFIX = com.paulgessinger.swift-paperless
SWP_APP_GROUP = group.com.paulgessinger.swift-paperless
SWP_KEYCHAIN_GROUP = $(AppIdentifierPrefix)$(SWP_BUNDLE_ID_PREFIX)
