// ShareExtension (app extension) — common settings shared by Debug and Release.
// The settings every extension shares are in Shared/AppExtension.xcconfig.

#include "../Shared/AppExtension.xcconfig"

PRODUCT_BUNDLE_IDENTIFIER = $(SWP_BUNDLE_ID_PREFIX).ShareExtension

SUPPORTS_MACCATALYST = YES

CODE_SIGN_ENTITLEMENTS = ShareExtension/ShareExtension.entitlements
PROVISIONING_PROFILE_SPECIFIER = $(SWP_SHARE_EXTENSION_PROVISIONING_PROFILE)

INFOPLIST_FILE = ShareExtension/Info.plist
